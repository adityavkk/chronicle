+function validateProjection(projection: string): void {
+  const length = new TextEncoder().encode(projection).byteLength
+  if (length < 1 || length > 128 || /[\u0000-\u001f\u007f]/u.test(projection)) {
+    throw new Error(
+      `Snapshot projection must be 1-128 UTF-8 bytes without controls`
+    )
+  }
+}
+
+function requireStrongETag(value: string | null): string {
+  if (!value || value.startsWith(`W/`) || !/^"[^"\r\n]+"$/u.test(value)) {
+    throw new Error(`Snapshot response requires a strong ETag`)
+  }
+  return value
+}
+
+async function sha256Digest(body: Uint8Array): Promise<string> {
+  const hash = await crypto.subtle.digest(`SHA-256`, body as BufferSource)
+  const bytes = new Uint8Array(hash)
+  let binary = ``
+  for (const byte of bytes) binary += String.fromCharCode(byte)
+  return `sha-256=:${btoa(binary)}:`
+}
