+      if (!head.exists) throw new Error(`Source stream missing`)
+      bOffset = head.offset
+      if (captureEnabled) captured = db.exportState()
+      else expect(() => db.exportState()).toThrow(`requires coherent capture`)
+      console.log(
+        `PUBLIC_EXPORT_B_BEFORE_A`,
+        JSON.stringify({
+          captureEnabled,
+          captured,
+          visible: db.collections.items.toArray,
+        })
+      )
+    } finally {
+      release()
+      await transaction.isPersisted.promise
+    }
+    if (!captureEnabled) {
