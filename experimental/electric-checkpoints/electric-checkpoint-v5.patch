+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { DurableStreamTestServer } from '@durable-streams/server'
+import { DurableStream } from '@durable-streams/client'
+import { processWake } from '../src/process-wake'
+import { clearRegistry, defineEntity } from '../src/define-entity'
+import {
+  createEntityStreamDB,
+  encodeEntityProjectionImage,
+} from '../src/entity-stream-db'
+import { checkpointFromImage } from '../src/runtime-checkpoint'
+import type { WebhookNotification, ProcessWakeConfig } from '../src/types'
+import { ev } from './helpers/event-fixtures'
+
+let server: DurableStreamTestServer
+let baseUrl: string
+let stream: DurableStream
+let doneBodies: Array<any>
+let config: ProcessWakeConfig
+const streamPath = `/streams/review2`
+const callback = `http://callback.test/wake`
+
+async function notification(epoch = 1): Promise<WebhookNotification> {
+  const head = await stream.head()
+  if (!head.exists || !head.offset) throw new Error(`Fixture stream missing`)
+  return {
+    consumerId: `review`,
+    epoch,
+    wakeId: `review2-${epoch}`,
+    streamPath,
+    streams: [{ path: streamPath, offset: head.offset! }],
+    callback,
+    claimToken: `test`,
+    entity: {
+      type: `review2`,
+      url: `/review2/entity`,
+      status: `active`,
+      streams: { main: streamPath },
+    },
+  }
+}
+
+beforeEach(async () => {
+  clearRegistry()
+  server = new DurableStreamTestServer({ port: 0 })
+  baseUrl = await server.start()
+  stream = await DurableStream.create({
+    url: `${baseUrl}${streamPath}`,
+    contentType: `application/json`,
+  })
+  doneBodies = []
+  const realFetch = globalThis.fetch
+  vi.spyOn(globalThis, `fetch`).mockImplementation(async (input, init) => {
+    const url =
+      typeof input === `string`
+        ? input
+        : input instanceof URL
+          ? input.href
+          : input.url
+    if (url === callback) {
+      const body = JSON.parse(String(init?.body))
+      if (body.done) doneBodies.push(body)
+      return Response.json({ ok: true, writeToken: `test` })
+    }
+    return realFetch(input, init)
+  })
+  config = {
+    baseUrl,
+    idleTimeout: 0,
+    heartbeatInterval: 1_000_000,
+    rawInputRecovery: `bounded-checkpoint-v1`,
+  }
+})
+
+afterEach(async () => {
+  vi.restoreAllMocks()
+  await server.stop()
+})
+
+it(`retries a queued input after its handler failed during promotion`, async () => {
+  const delivered: string[] = []
+  let fail = true
+  defineEntity(`review2`, {
+    handler: (ctx, wake) => {
+      delivered.push(String(wake.payload))
+      if (fail) {
+        fail = false
+        throw new Error(`handler failed`)
+      }
+      ctx.sleep()
+    },
+  })
+  await stream.append(
+    JSON.stringify(
+      ev(`inbox`, `a`, `insert`, {
+        payload: `A`,
+        mode: `queued`,
+        status: `pending`,
+      })
+    )
+  )
+  await expect(processWake(await notification(), config)).rejects.toThrow(
+    `handler failed`
+  )
+  expect(doneBodies.at(-1).acks).toEqual([])
+  await processWake(await notification(2), config)
+  expect(delivered).toEqual([`A`, `A`])
+})
+
+it(`retains certified handler completion despite later sandbox cleanup failure`, async () => {
+  let failDispose = true
+  let calls = 0
+  defineEntity(`review2`, {
+    handler: (ctx) => {
+      calls++
+      if (failDispose) {
+        failDispose = false
+        vi.spyOn(ctx.sandbox, `dispose`).mockRejectedValueOnce(
+          new Error(`dispose failed`)
+        )
+      }
+      ctx.sleep()
+    },
+  })
+  await stream.append(
+    JSON.stringify(ev(`inbox`, `a`, `insert`, { payload: `A` }))
+  )
+  await expect(processWake(await notification(), config)).rejects.toThrow(
+    `dispose failed`
+  )
+  expect(doneBodies.at(-1).acks).toEqual([])
+  const replay = createEntityStreamDB(
+    `${baseUrl}${streamPath}`,
+    undefined,
+    undefined,
+    {
+      onCommittedSnapshot: () => {},
+    }
+  )
+  await replay.preload()
+  const image = replay.utils.exportSnapshot(`review2`)
+  replay.close()
+  await processWake(await notification(2), config)
+  console.log(
+    `DISPOSE_AFTER_MARKER`,
+    JSON.stringify({
+      doneBodies,
+      calls,
+      checkpoint: checkpointFromImage(image),
+    })
+  )
+  expect(checkpointFromImage(image)).not.toBeNull()
+  expect(calls).toBe(1)
+  expect(doneBodies.at(-1).acks).toHaveLength(1)
+})
+
+it(`encodes identical canonical rows for same-key writes across HTTP batches`, async () => {
+  const changes = [
+    ev(`state:notes`, `a`, `insert`, { x: 1, y: 2 }),
+    ev(`state:notes`, `b`, `insert`, { z: 3 }),
+    ev(`state:notes`, `a`, `update`, { x: 4, q: 5 }),
+    { type: `state:notes`, key: `b`, headers: { operation: `delete` } },
+    ev(`state:notes`, `b`, `insert`, { r: 6 }),
+    ev(`state:notes`, `a`, `update`, { nested: { yes: true } }),
+  ]
+  async function project(groups: any[][]) {
+    let next = 0
+    const db = createEntityStreamDB(
+      `https://example.test/rows`,
+      { notes: {} } as any,
+      undefined,
+      {
+        onCommittedSnapshot: () => {},
+        streamOptions: {
+          fetch: async (_input, init) => {
+            const group = groups[next++]
+            if (!group)
+              return new Promise<Response>((_resolve, reject) =>
+                init?.signal?.addEventListener(`abort`, () =>
+                  reject(new DOMException(`Aborted`, `AbortError`))
+                )
+              )
+            return new Response(JSON.stringify(group), {
+              headers: {
+                'content-type': `application/json`,
+                'stream-next-offset':
+                  next === groups.length ? `99` : `0${next}`,
+                ...(next === groups.length
+                  ? { 'stream-up-to-date': `true` }
+                  : {}),
+              },
+            })
+          },
+        },
+      }
+    )
+    await db.preload()
+    const image = db.utils.exportSnapshot(`review2`)
+    db.close()
+    return image
+  }
+  const single = await project([changes])
+  const split = await project(changes.map((change) => [change]))
+  console.log(
+    `ROW_GROUPING`,
+    JSON.stringify({
+      single: single.rowsByCollection.notes,
+      split: split.rowsByCollection.notes,
+    })
+  )
+  expect(new TextDecoder().decode(encodeEntityProjectionImage(single))).toBe(
