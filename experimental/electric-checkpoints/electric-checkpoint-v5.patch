+import type {
+  EntityProjectionImageV3,
+  StateCollectionProxy,
+  WakeMetrics,
+} from '../src/index'
+
+const enabled = Boolean(
+  process.env.CHRONICLE_STREAM_ROOT &&
+    process.env.CHRONICLE_TOKEN_DIR &&
+    process.env.CHRONICLE_CALLBACK_GATE_URL
+)
