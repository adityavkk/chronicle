+  ? (
+      await readFile(`${process.env.CHRONICLE_TOKEN_DIR}/.writer-token`, `utf8`)
+    ).trim()
+  : ``
+const publisher = enabled
+  ? (
+      await readFile(
+        `${process.env.CHRONICLE_TOKEN_DIR}/.publisher-token`,
+        `utf8`
+      )
+    ).trim()
+  : ``
