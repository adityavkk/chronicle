+                },
+                {
+                  type: `state:notes`,
+                  key: `a`,
+                  value: { body: `replacement`, nested: { stable: true } },
+                  headers: { operation: `update`, offset: `entry-2` },
+                },
+                {
+                  type: `state:notes`,
+                  key: `b`,
+                  headers: { operation: `delete`, offset: `entry-3` },
+                },
