+const suite = enabled ? describe : describe.skip
+const version = `checkpoint-real-e2e-v1`
+const rowSchema = z.object({ key: z.string(), inputs: z.array(z.string()) })
+type Row = z.infer<typeof rowSchema>
+
+function latch() {
+  let release!: () => void
+  const promise = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  return { promise, release }
+}
+
+suite(`real bounded runtime checkpoint recovery`, () => {
+  const metrics = new Map<string, Array<WakeMetrics>>()
+  const inputs = new Map<string, Array<Array<string>>>()
+  const selfObservationInputs = new Map<string, Array<Array<string>>>()
+  const attempts = new Map<string, number>()
+  const canceled = new Set<string>()
+  const blocks = new Map<
+    string,
+    { started: ReturnType<typeof latch>; resume: ReturnType<typeof latch> }
+  >()
+  let nextWebhookHold: {
+    arrived: ReturnType<typeof latch>
+    resume: ReturnType<typeof latch>
+  } | null = null
+  const runtime = runtimeTest({
+    durableStreamsUrl: (
+      gate?.streamRoot ?? `http://127.0.0.1:1/v1/stream/`
+    ).replace(/\/$/, ``),
+    durableStreamsBearer: token,
+    rawInputRecovery: `bounded-checkpoint-v1`,
+    projectionSnapshots: {
+      projectionVersion: version,
+      rawInputRecovery: `bounded-checkpoint-v1`,
+      publisherHeaders: () => ({ authorization: `Bearer ${publisher}` }),
+      minReplayEvents: 0,
+      minReplayMs: 0,
+      minPublishIntervalMs: 0,
+      missBackoffMs: 0,
+    },
+    resetBackend: false,
+    onWakeMetrics(value) {
+      const list = metrics.get(value.entityUrl) ?? []
+      list.push(value)
+      metrics.set(value.entityUrl, list)
+    },
+    async beforeWebhook() {
+      if (!nextWebhookHold) return
+      const hold = nextWebhookHold
+      nextWebhookHold = null
+      hold.arrived.release()
+      await hold.resume.promise
+    },
+  })
+  const rawInputs = (events: Array<{ type: string; value?: unknown }>) =>
+    events
+      .filter((event) => event.type === `inbox`)
+      .map(
+        (event) => (event.value as { payload?: { id?: string } })?.payload?.id
+      )
+      .filter((id): id is string => typeof id === `string`)
+  runtime.define(`e2e`, {
+    state: { rows: { schema: rowSchema, primaryKey: `key` } },
+    async handler(ctx) {
+      const self = await ctx.observe(entitySource(ctx.entityUrl))
+      const list = selfObservationInputs.get(ctx.entityUrl) ?? []
+      list.push(rawInputs(self.events))
+      selfObservationInputs.set(ctx.entityUrl, list)
+      const delta = rawInputs(ctx.events)
+      const observed = inputs.get(ctx.entityUrl) ?? []
+      observed.push(delta)
+      inputs.set(ctx.entityUrl, observed)
+      if (delta.includes(`cancel-block`) && canceled.has(ctx.entityUrl)) return
+      const block = blocks.get(ctx.entityUrl)
+      if (
