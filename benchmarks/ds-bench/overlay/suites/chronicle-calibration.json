{
  "suite": "chronicle-calibration",
  "_doc": "Predeclared Chronicle to Redis CPU split calibration. Publish every arm and freeze the unique highest valid median before resolving parity suites.",
  "cluster": {
    "server_machine": "c4d-standard-16-lssd",
    "server_cpus": 4,
    "client_machine": "n2d-standard-32",
    "client_nodes": 2,
    "cluster_name": "chdb-cal",
    "zone": "europe-west4-b",
    "region": "europe-west4"
  },
  "saturation": {
    "plateau_pct": 8,
    "patience": 2,
    "fleet_cpu": 2,
    "connections": 256,
    "repeats": 3,
    "warmup_secs": 12,
    "measure_secs": 20,
    "setup_concurrency": 32,
    "payload_bytes": 256
  },
  "modes": [
    "chronicle"
  ],
  "server_configs": {
    "chronicle": [
      {
        "label": "chronicle-cal-1-3",
        "args": "always:1:3"
      },
      {
        "label": "chronicle-cal-2-2",
        "args": "always:2:2"
      },
      {
        "label": "chronicle-cal-3-1",
        "args": "always:3:1"
      }
    ]
  },
  "stream_counts": [
    10000
  ],
  "pod_ladder": {
    "10000": [
      1,
      2,
      4,
      8,
      12,
      16
    ]
  }
}
