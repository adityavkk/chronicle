+/// Ensure the stream holds exactly `seed_bytes` of resident data. Failed
+/// concurrent appends are retried from a fresh size probe. The exact-size check
+/// prevents a short setup history from being reported as catch-up throughput.
+async fn ensure_seeded(
+    b: &Backend,
+    stream: &str,
+    seed_bytes: u64,
+    record_bytes: usize,
+    timeout: Duration,
+) -> Result<SeedStats> {
+    if seed_bytes == 0 {
+        return Ok(SeedStats::default());
+    }
+    let seed = async {
+        let mut stats = SeedStats::default();
+        let mut seed_rounds = 0u64;
+        let mut stored_overhead_bytes = None;
+        loop {
+            let mut current_bytes = probe_stream_size(b, stream)
+                .await
+                .context("probe stream before seed round")?;
+            if current_bytes == seed_bytes {
+                stats.retry_rounds += seed_rounds.saturating_sub(1);
+                stats.verified_streams = 1;
+                stats.verified_min_bytes = current_bytes;
+                stats.verified_max_bytes = current_bytes;
+                tracing::info!(
+                    current_bytes,
+                    seed_bytes,
+                    append_attempts = stats.append_attempts,
+                    append_failures = stats.append_failures,
+                    retry_rounds = stats.retry_rounds,
+                    "stream seed verified"
+                );
+                return Ok(stats);
+            }
+            if current_bytes > seed_bytes {
+                anyhow::bail!(
+                    "stream already exceeds exact seed target: current={current_bytes} \
+                     target={seed_bytes}"
+                );
+            }
+
+            let stored_overhead_bytes = match stored_overhead_bytes {
+                Some(overhead) => overhead,
+                None => {
+                    let calibration_payload_bytes =
+                        usize::try_from((seed_bytes - current_bytes).min(record_bytes as u64))
+                            .context("calibration payload size does not fit usize")?;
+                    let payload = fill_payload(calibration_payload_bytes, 0xC0DE);
+                    stats.append_attempts += 1;
+                    let accepted = b
+                        .append_request(
+                            0,
+                            stream,
+                            &payload,
+                            None,
+                            "application/octet-stream",
+                        )
+                        .send()
+                        .await
+                        .map(|response| response.status().is_success())
+                        .unwrap_or(false);
+                    if !accepted {
+                        stats.append_failures += 1;
+                    }
+                    let calibrated_bytes = probe_stream_size(b, stream)
+                        .await
+                        .context("probe stream after seed calibration")?;
+                    if calibrated_bytes <= current_bytes {
+                        stats.retry_rounds += 1;
+                        tracing::warn!(
+                            current_bytes,
+                            calibrated_bytes,
+                            calibration_payload_bytes,
+                            "seed calibration append made no visible progress; retrying"
+                        );
+                        continue;
+                    }
+                    let stored_delta = calibrated_bytes - current_bytes;
+                    let overhead = stored_delta
+                        .checked_sub(calibration_payload_bytes as u64)
+                        .with_context(|| {
+                            format!(
+                                "server stored fewer bytes than the calibration payload: \
+                                 stored_delta={stored_delta} payload={calibration_payload_bytes}"
+                            )
+                        })?;
+                    tracing::info!(
+                        calibration_payload_bytes,
+                        stored_delta,
+                        stored_overhead_bytes = overhead,
+                        "seed storage framing calibrated"
+                    );
+                    stored_overhead_bytes = Some(overhead);
+                    current_bytes = calibrated_bytes;
+                    overhead
+                }
+            };
+
+            let payload_plan = seed_payload_plan(
+                current_bytes,
+                seed_bytes,
+                record_bytes,
+                stored_overhead_bytes,
+            )?;
+            if payload_plan.is_empty() {
+                continue;
+            }
+            seed_rounds += 1;
+            let record_count = payload_plan.iter().map(|(_, count)| *count).sum::<usize>();
+            stats.append_attempts += record_count as u64;
+            tracing::info!(
+                current_bytes,
+                seed_bytes,
+                record_count,
+                record_bytes,
+                stored_overhead_bytes,
+                seed_round = seed_rounds,
+                "seeding stream"
+            );
+
+            let semaphore = Arc::new(tokio::sync::Semaphore::new(32));
+            let mut joins = Vec::with_capacity(record_count);
+            for (payload_bytes, count) in payload_plan {
+                let payload = Arc::new(fill_payload(payload_bytes, 0xC0DE));
+                for _ in 0..count {
+                    let permit = semaphore.clone().acquire_owned().await.unwrap();
+                    let b = b.clone();
+                    let stream = stream.to_string();
+                    let payload = payload.clone();
+                    joins.push(tokio::spawn(async move {
+                        let _permit = permit;
+                        b.append_request(0, &stream, &payload, None, "application/octet-stream")
+                            .send()
+                            .await
+                            .map(|r| r.status().is_success())
+                            .unwrap_or(false)
+                    }));
+                }
+            }
+            let mut failed = 0u64;
+            for join in joins {
+                if !join.await.unwrap_or(false) {
+                    failed += 1;
+                }
+            }
+            stats.append_failures += failed;
+            if failed > 0 {
+                tracing::warn!(
+                    failed,
+                    record_count,
+                    seed_round = seed_rounds,
+                    "seed appends failed; retrying"
+                );
+            }
+        }
+    };
+    tokio::time::timeout(timeout, seed)
+        .await
+        .with_context(|| {
+            format!(
+                "exact seed verification timed out for {stream} after {}s",
+                timeout.as_secs()
+            )
+        })?
 }
 
