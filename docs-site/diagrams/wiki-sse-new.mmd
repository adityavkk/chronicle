flowchart LR
    A["one append"]:::source --> R[("Redis<br/>durable stream + Pub/Sub")]:::db
    R -.->|"one physical connection"| X["store notification multiplexer<br/>logical channels · generation acknowledgements"]:::mux
    X -.->|"one coalesced wake hint"| H["per-stream fanout hub<br/>one logical registration · one durable read<br/>one formatted data event"]:::hero
    H -->|"read durable suffix once"| R
    H --> Q[["bounded replay window<br/>1 MiB default"]]:::buffer

    subgraph clients["local SSE clients"]
      C1["client 1<br/>offset + socket"]:::client
      C2["client 2<br/>offset + socket"]:::client
      CN["client 1,000<br/>offset + socket"]:::client
    end

    Q -->|"shared event"| C1
    Q -->|"shared event"| C2
    Q -->|"shared event"| CN

    M["measured<br/>1.000 reads per append"]:::metric
    H --> M

