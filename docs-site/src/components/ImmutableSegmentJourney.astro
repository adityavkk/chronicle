---
import Demo from "./Demo.astro";

const scenes = [
  {
    label: "Request",
    moment: "Priya resumes an order audit stream",
    context:
      "Her client asks for /orders/store-321 from offset …4800. The stream has a sealed historical prefix and a short open tail.",
    old: {
      client:
        "The client sends the same Durable Streams GET and waits for ordered frames after …4800.",
      internals: [
        "Chronicle starts a bounded catch-up response.",
        "The Redis page reader captures the stream tail and incarnation.",
        "Every response page will come from the Redis frame ZSET.",
      ],
      result: "Redis owns append truth and all replay bytes.",
    },
    next: {
      client:
        "The client sends the same request. It does not know that a segment plane is enabled.",
      internals: [
        "Chronicle starts the same bounded catch-up response.",
        "The Redis primary captures the incarnation, content type, closed state, and upper tail.",
        "That first logical client page renews sliding TTL once.",
      ],
      result: "Redis still owns append truth and the response snapshot.",
    },
  },
  {
    label: "Choose storage",
    moment: "Chronicle decides where history may be read",
    context:
      "The requested offset is behind the manifest's sealed boundary. The selected mode now controls whether Chronicle may use the immutable copy.",
    old: {
      client:
        "The client sees no mode or storage header. It receives only protocol data and cursor fields.",
      internals: [
        "In off mode, Chronicle has no segment manifest to consult.",
        "In shadow mode, Chronicle may create and verify a manifest but does not serve it.",
        "Both paths keep reading Redis pages.",
      ],
      result: "Off and shadow preserve the old serving path.",
    },
    next: {
      client:
        "Serving mode does not change the client's request or response format.",
      internals: [
        "Chronicle loads the current manifest and verifies its digest.",
        "The manifest must match the primary incarnation and content type.",
        "Chronicle creates a unique reader lease and pins that exact generation.",
      ],
      result: "One reader is bound to one manifest and one Redis snapshot.",
    },
  },
  {
    label: "Read history",
    moment: "The response crosses the sealed prefix",
    context:
      "Chronicle must return whole frames in offset order while keeping each storage operation bounded.",
    old: {
      client:
        "Priya receives bounded pages. Each complete frame advances her opaque resume offset.",
      internals: [
        "Every page asks Redis for the next sorted-set range.",
        "Redis supplies all historical payload bytes.",
        "Chronicle decodes each frame and writes it to the response.",
      ],
      result: "Page bounds help memory, but Redis serves the complete history.",
    },
    next: {
      client:
        "Priya receives the same frames and offsets in the same order.",
      internals: [
        "The sparse index selects a position in one immutable segment.",
        "Chronicle reads complete 64 KiB blocks and verifies each SHA-256 digest.",
        "One page returns at most one segment range and at most 1,024 frames.",
      ],
      result: "Verified segment blocks serve the sealed prefix.",
    },
  },
  {
    label: "Join the tail",
    moment: "The immutable prefix reaches the Redis boundary",
    context:
      "A producer appended more records after the manifest was sealed. Those records are inside the first page's captured upper tail.",
    old: {
      client:
        "The response continues without a visible boundary between old and recent frames.",
      internals: [
        "The next Redis page continues from the last returned offset.",
        "Concurrent appends after the captured upper tail stay outside this response.",
        "A delete followed by recreate invalidates the snapshot.",
      ],
      result: "One Redis snapshot controls the complete response.",
    },
    next: {
      client:
        "The response also continues without exposing the storage boundary.",
      internals: [
        "Chronicle switches to the Redis hot tail under the original primary snapshot.",
        "It does not capture a second tail at the boundary.",
        "If a segment range is missing or corrupt, the lease falls back to bounded primary pages.",
      ],
      result: "Old and new bytes cannot cross incarnations or snapshot tails.",
    },
  },
  {
    label: "Finish",
    moment: "Priya reaches the captured tail",
    context:
      "Chronicle has returned every frame after …4800 through the tail captured when the request began.",
    old: {
      client:
        "Priya stores the final Stream-Next-Offset and can resume from it later.",
      internals: [
        "The handler releases the primary snapshot.",
        "The Redis frame ZSET remains the complete primary copy.",
        "A later request captures a new tail.",
      ],
      result: "The client confirms one consistent response.",
    },
    next: {
      client:
        "Priya stores the same final offset. Rollback does not change her resume behavior.",
      internals: [
        "The handler confirms the final page, then releases the reader lease and manifest pin.",
        "Changing serving to shadow or startup mode to off sends later reads through Redis.",
        "The full Redis ZSET remains available because this prototype never trims it.",
      ],
      result: "Rollback changes the internal read plane, not durable data.",
    },
  },
];
---

<Demo label="One client catch-up, followed through both paths">
  <div class="journey" data-segment-journey>
    <div class="scenario">
      <div>
        <span>Scenario</span>
        <strong>Resume an order audit stream from a saved offset</strong>
      </div>
      <div class="actors" aria-label="Journey actors">
        <span><i class="person"></i> Priya</span>
        <span><i class="service"></i> Chronicle</span>
        <span><i class="manifest"></i> Manifest</span>
        <span><i class="storage"></i> Segments</span>
        <span><i class="redis"></i> Redis</span>
      </div>
    </div>

    <div class="step-tabs" role="tablist" aria-label="Immutable segment catch-up steps">
      {
        scenes.map((scene, index) => (
          <button
            type="button"
            role="tab"
            id={`segment-journey-tab-${index}`}
            aria-controls={`segment-journey-scene-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-segment-journey-tab={index}
          >
            <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
            <span>{scene.label}</span>
          </button>
        ))
      }
    </div>

    <div class="scenes">
      {
        scenes.map((scene, index) => (
          <section
            class="scene"
            id={`segment-journey-scene-${index}`}
            role="tabpanel"
            aria-labelledby={`segment-journey-tab-${index}`}
            data-segment-journey-scene={index}
            hidden={index !== 0}
          >
            <header class="moment">
              <span>Moment {index + 1}</span>
              <h3>{scene.moment}</h3>
              <p>{scene.context}</p>
            </header>

            <div class="paths">
              <article class="path old">
                <div class="path-head">
                  <span>Redis ZSET path</span>
                  <strong>History stays on the primary</strong>
                </div>
                <div class="client-action">
                  <span>What Priya observes</span>
                  <p>{scene.old.client}</p>
                </div>
                <div class="internal-action">
                  <span>Inside Chronicle and storage</span>
                  <ol>
                    {scene.old.internals.map((item) => <li>{item}</li>)}
                  </ol>
                </div>
                <p class="result">{scene.old.result}</p>
              </article>

              <article class="path next">
                <div class="path-head">
                  <span>Serving segment path</span>
                  <strong>Sealed history moves off the frame ZSET</strong>
                </div>
                <div class="client-action">
                  <span>What Priya observes</span>
                  <p>{scene.next.client}</p>
                </div>
                <div class="internal-action">
                  <span>Inside Chronicle and storage</span>
                  <ol>
                    {scene.next.internals.map((item) => <li>{item}</li>)}
                  </ol>
                </div>
                <p class="result">{scene.next.result}</p>
              </article>
            </div>
          </section>
        ))
      }
    </div>

    <div class="invariant">
      <strong>The client contract is unchanged.</strong>
      <span>
        Both paths return the same ordered frames, snapshot boundary, cursor,
        content type, closure state, and retry behavior. The serving path may
        move sealed reads away from the frame ZSET. It may not change append
        acknowledgement or the meaning of an offset.
      </span>
    </div>
  </div>

  <span slot="caption">
    The offset is shortened for readability. Chronicle treats the complete
    offset and the snapshot token as opaque values.
  </span>
</Demo>

<script>
  document.querySelectorAll<HTMLElement>("[data-segment-journey]").forEach((root) => {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-segment-journey-tab]"),
    );
    const scenes = Array.from(
      root.querySelectorAll<HTMLElement>("[data-segment-journey-scene]"),
    );

    const select = (index: number, moveFocus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && moveFocus) tab.focus();
      });
      scenes.forEach((scene, sceneIndex) => {
        scene.hidden = sceneIndex !== index;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        let next = index;
        if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        if (event.key === "Home") next = 0;
        if (event.key === "End") next = tabs.length - 1;
        select(next, true);
      });
    });
  });
</script>

<style lang="scss">
  .journey {
    color: var(--ink);
  }
  .scenario {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 20px;
  }
  .scenario > div:first-child {
    display: grid;
    gap: 4px;
  }
  .scenario > div:first-child > span,
  .client-action > span,
  .internal-action > span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .scenario strong {
    font-size: 15px;
  }
  .actors {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
  }
  .actors span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 9px;
    color: var(--ink-mute);
  }
  .actors i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .actors i.service { background: var(--ink); }
  .actors i.manifest { border-radius: 1px; background: var(--warn); }
  .actors i.storage { border-radius: 1px; background: var(--ok); }
  .actors i.redis { background: var(--bad); }
  .step-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: var(--paper);
  }
  .step-tabs button {
    min-width: 0;
    padding: 11px 9px 12px;
    border: 0;
    border-right: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-mute);
    font: 600 11px/1.25 var(--sans);
    text-align: left;
    cursor: pointer;
  }
  .step-tabs button:last-child { border-right: 0; }
  .step-tabs button:hover { background: var(--paper-warm); color: var(--ink); }
  .step-tabs button[aria-selected="true"] {
    background: var(--accent-tint);
    color: var(--accent-deep);
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .step-number {
    display: block;
    margin-bottom: 5px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .scene {
    padding-top: 24px;
  }
  .scene[hidden] { display: none; }
  .moment {
    margin-bottom: 18px;
    padding-left: 14px;
    border-left: 3px solid var(--accent);
  }
  .moment > span {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .moment h3 {
    margin: 3px 0 4px;
    padding: 0;
    border: 0;
    font-size: 18px;
    font-weight: 650;
  }
  .moment p {
    max-width: 74ch;
    margin: 0;
    color: var(--ink-mute);
    font-size: 13px;
    line-height: 1.5;
  }
  .paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .path {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--card);
  }
  .path.old { border-top: 3px solid var(--bad); }
  .path.next { border-top: 3px solid var(--accent); }
  .path-head {
    display: grid;
    gap: 3px;
    padding: 13px 15px;
    border-bottom: 1px solid var(--rule-soft);
    background: var(--paper);
  }
  .path-head span {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .old .path-head span { color: var(--bad); }
  .next .path-head span { color: var(--accent); }
  .path-head strong {
    font-size: 13px;
    line-height: 1.35;
  }
  .client-action,
  .internal-action {
    padding: 14px 15px;
  }
  .client-action {
    min-height: 120px;
    border-bottom: 1px solid var(--rule-soft);
    background: color-mix(in srgb, var(--accent-tint) 42%, var(--card));
  }
  .client-action p {
    margin: 7px 0 0;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .internal-action {
    min-height: 230px;
  }
  .internal-action ol {
    margin: 9px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: internals;
  }
  .internal-action li {
    position: relative;
    margin-top: 9px;
    padding-left: 24px;
    font-size: 12.5px;
    line-height: 1.45;
    counter-increment: internals;
  }
  .internal-action li::before {
    position: absolute;
    top: 1px;
    left: 0;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    content: counter(internals);
    background: var(--paper-warm);
    color: var(--ink-mute);
    font: 500 9px/17px var(--mono);
    text-align: center;
  }
  .result {
    min-height: 64px;
    margin: 0;
    padding: 12px 15px 14px;
    border-top: 1px solid var(--rule-soft);
    background: var(--paper);
    font: 500 10.5px/1.5 var(--mono);
    color: var(--ink-mute);
  }
  .next .result { color: var(--accent-deep); }
  .invariant {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 20px;
    margin-top: 16px;
    padding: 15px 16px;
    border-left: 3px solid var(--warn);
    background: color-mix(in srgb, var(--paper-warm) 74%, var(--card));
    font-size: 12.5px;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .scenario { align-items: flex-start; flex-direction: column; }
    .actors { justify-content: flex-start; }
    .step-tabs {
      grid-template-columns: 1fr;
      overflow: visible;
    }
    .step-tabs button {
      display: grid;
      grid-template-columns: 30px 1fr;
      align-items: center;
      padding: 9px 12px;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .step-tabs button:last-child { border-bottom: 0; }
    .step-tabs button[aria-selected="true"] {
      box-shadow: inset 3px 0 0 var(--accent);
    }
    .step-number { margin: 0; }
    .paths { grid-template-columns: 1fr; }
    .client-action,
    .internal-action,
    .result { min-height: 0; }
    .invariant { grid-template-columns: 1fr; gap: 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .step-tabs button { scroll-behavior: auto; }
  }
</style>
