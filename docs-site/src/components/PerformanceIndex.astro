---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = {
  catchup: `${base}/performance-improvements/bounded-catchup`,
  sse: `${base}/performance-improvements/sse-fanout`,
  segments: `${base}/performance-improvements/immutable-segments`,
  readOnly: `${base}/performance-improvements/read-only-fast-path`,
  asyncSubscriptions: `${base}/performance-improvements/async-subscription-fanout`,
  scaling: `${base}/horizontal-scale`,
  loadTests: `${base}/load-testing`,
  issue172: "https://github.com/adityavkk/chronicle/issues/172",
  catchupAdr: "https://github.com/adityavkk/chronicle/blob/main/docs/adr/0004-bounded-read-pages-and-snapshot-catch-up.md",
  sseAdr: "https://github.com/adityavkk/chronicle/blob/main/docs/adr/0005-per-instance-sse-stream-fanout.md",
  segmentsAdr: "https://github.com/adityavkk/chronicle/blob/main/docs/adr/0006-immutable-segment-read-plane-prototype.md",
  readOnlyAdr: "https://github.com/adityavkk/chronicle/blob/main/docs/adr/0007-fuse-root-pages-and-register-live-reads-first.md",
  catchupEvidence: "https://github.com/adityavkk/chronicle/blob/main/docs/benchmarks/bounded-catchup.md",
  segmentsEvidence: "https://github.com/adityavkk/chronicle/blob/main/docs/benchmarks/immutable-segments.md",
  readOnlyEvidence: "https://github.com/adityavkk/chronicle/blob/main/docs/research/12-read-only-fast-path-results.md",
  asyncSubscriptionsEvidence: "https://github.com/adityavkk/chronicle/blob/main/docs/perf-async-subscription-fanout/results.md",
  sseEvidence: "https://github.com/adityavkk/chronicle/blob/main/docs/benchmarks/sse-fanout/20260731-shared-hub-local/README.md",
  comparison: "https://github.com/adityavkk/chronicle/blob/main/docs/benchmarks/ds-bench/configuration-comparison.md",
};
---

<div class="improvements">
  <article class="improvement featured">
    <div class="head">
      <span class="num">01</span>
      <span class="status">validated</span>
    </div>
    <h3>Bounded catch-up</h3>
    <p class="result">128 errors to 435 complete measured replays</p>
    <p>
      <strong>Before:</strong> one long read could load the complete remaining
      stream into memory. <strong>Now:</strong> Chronicle reads and sends about
      1 MiB of whole frames at a time.
    </p>
    <nav aria-label="Bounded catch-up links">
      <a class="primary" href={links.catchup}>Read the explainer <span aria-hidden="true">→</span></a>
      <a href={links.catchupAdr}>Architecture decision <span aria-hidden="true">↗</span></a>
      <a href={links.catchupEvidence}>Evidence report <span aria-hidden="true">↗</span></a>
    </nav>
  </article>

  <article class="improvement featured">
    <div class="head">
      <span class="num">02</span>
      <span class="status">validated</span>
    </div>
    <h3>SSE stream fanout</h3>
    <p class="result">970.5 to 1.000 reads per append; 100 channels on 1 connection</p>
    <p>
      <strong>Before:</strong> every browser reread the same update from Redis.
      <strong>Now:</strong> one stream hub reads and formats it once, an indexed
      replay ring preserves exact boundaries, and the store multiplexer owns the
      bounded Pub/Sub connection set. Socket writes remain per client.
    </p>
    <nav aria-label="SSE fanout links">
      <a class="primary" href={links.sse}>Read the explainer <span aria-hidden="true">→</span></a>
      <a href={links.sseAdr}>Architecture decision <span aria-hidden="true">↗</span></a>
      <a href={links.sseEvidence}>Evidence report <span aria-hidden="true">↗</span></a>
    </nav>
  </article>

  <article class="improvement featured">
    <div class="head">
      <span class="num">03</span>
      <span class="status">prototype</span>
    </div>
    <h3>Immutable sealed segments</h3>
    <p class="result">2.67 to 4.26 times same-host sealed gain; rerun required</p>
    <p>
      <strong>Before:</strong> Redis served every page of history.
      <strong>Now:</strong> verified segments can serve the older prefix while
      Redis serves the recent tail and remains the complete fallback.
    </p>
    <nav aria-label="Immutable segments links">
      <a class="primary" href={links.segments}>Read the explainer <span aria-hidden="true">→</span></a>
      <a href={links.segmentsAdr}>Architecture decision <span aria-hidden="true">↗</span></a>
      <a href={links.segmentsEvidence}>Evidence report <span aria-hidden="true">↗</span></a>
    </nav>
  </article>

  <article class="improvement featured">
    <div class="head">
      <span class="num">04</span>
      <span class="status">validated</span>
    </div>
    <h3>Read-only and fused root pages</h3>
    <p class="result">GET HGETALL calls 6 to 1; root-page scripts 2 to 1</p>
    <p>
      <strong>Before:</strong> persistent reads loaded producer state, loaded
      metadata repeatedly, and touched Redis expiry state.
      <strong>Now:</strong> one atomic root page carries bounded frames and the
      typed state that GET, long-poll, and SSE need.
    </p>
    <nav aria-label="Read-only fast path links">
      <a class="primary" href={links.readOnly}>Read the explainer <span aria-hidden="true">→</span></a>
      <a href={links.issue172}>GitHub issue #172 <span aria-hidden="true">↗</span></a>
      <a href={links.readOnlyAdr}>Architecture decision <span aria-hidden="true">↗</span></a>
      <a href={links.readOnlyEvidence}>Evidence report <span aria-hidden="true">↗</span></a>
    </nav>
  </article>

  <article class="improvement featured">
    <div class="head">
      <span class="num">05</span>
      <span class="status">validated</span>
    </div>
    <h3>Async subscription fanout</h3>
    <p class="result">1,000-sub append p99: 5,053.845 to 1.235 ms</p>
    <p>
      <strong>Before:</strong> the append response waited for subscriber lookup,
      hydration, linked-tail reads, and wake arming. <strong>Now:</strong> it waits
      for one bounded local dirty-queue transition. A Manager-owned worker
      performs fanout after the durable commit.
    </p>
    <nav aria-label="Async subscription fanout links">
      <a class="primary" href={links.asyncSubscriptions}>Read the explainer <span aria-hidden="true">→</span></a>
      <a href={links.asyncSubscriptionsEvidence}>Evidence report <span aria-hidden="true">↗</span></a>
    </nav>
  </article>

  <article class="improvement">
    <div class="head">
      <span class="num">06</span>
      <span class="status">shipped</span>
    </div>
    <h3>Horizontal scale</h3>
    <p class="result">12.48 to 12.61 ms fanout p99 from 1 to 8 replicas</p>
    <p>
      Chronicle homes subscription state by Redis slot and divides claim work.
      The cloud curve stayed flat through eight replicas. Quota blocked the
      12 replica point and the cloud run with multiple shards.
    </p>
    <nav aria-label="Horizontal scale links">
      <a class="primary" href={links.scaling}>Read the scaling report <span aria-hidden="true">→</span></a>
      <a href={links.loadTests}>Open the cloud load tests <span aria-hidden="true">→</span></a>
    </nav>
  </article>

  <article class="improvement">
    <div class="head">
      <span class="num">07</span>
      <span class="status">measured</span>
    </div>
    <h3>Configurations and systems</h3>
    <p class="result">Chronicle compared with Ursula, Rust, and Node</p>
    <p>
      The benchmark record separates Chronicle node size, Redis size, replica
      count, durability, and workload shape. Historical replay remains
      Chronicle's largest measured gap.
    </p>
    <nav aria-label="Configuration comparison links">
      <a class="primary" href={links.comparison}>Open the comparison report <span aria-hidden="true">↗</span></a>
      <a href={links.loadTests}>Read the load test method <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</div>

<style lang="scss">
  .improvements {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .improvement {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 22px;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .improvement.featured::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    content: "";
    background: var(--accent);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .num { color: var(--accent); }
  .status {
    padding: 3px 8px;
    border: 1px solid rgba(36, 131, 123, 0.35);
    border-radius: 999px;
    color: var(--accent-deep);
    background: var(--accent-tint);
  }
  h3 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.2;
  }
  .result {
    margin: 12px 0 0;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--accent-deep);
  }
  p {
    margin: 16px 0 22px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-mute);
  }
  nav {
    display: grid;
    gap: 9px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--rule-soft);
  }
  a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-mute);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.4;
    text-decoration: none;
  }
  a:hover { color: var(--accent); }
  a.primary {
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 980px) {
    .improvements { grid-template-columns: 1fr; }
  }
</style>
